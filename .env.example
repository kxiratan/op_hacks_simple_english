# Copy this file to .env and paste your OpenRouter API key after the equals sign.
# .env is git-ignored; never commit a real key. Create keys at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which model to use (any slug from https://openrouter.ai/models).
# Leave empty for the default, anthropic/claude-opus-5.5.
OPENROUTER_MODEL=
